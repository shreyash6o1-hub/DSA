// concat
select concat(first_name, " ", last_name) as full_name from employees;

//upper case , lower case
select upper(first_name) from employees;
select lower(first_name) from employees;

//trim
select trim("     Ok      ") ;  ==> OK

//substring
select SUBSTRING(first_name, 1, 3) as first_three from employees;

//locate
select locate('a', first_name) as position from employees; ==> gives index

//replace
select replace(email, "@example.com", "@example2.com") from employees;

//reverse
select reverse(first_name) from employees;
